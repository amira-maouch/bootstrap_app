{
  "routing": {
    "appPathPrefix": ""
  },
  "title": "Bootstrap App",
  "root": "root",
  "theme": "sky",
  "plugins": [],
  "errorRoutes": {
    "404": {
      "widget": "errors/not-found"
    }
  },
  "routes": {
    "login": {
      "widget": "pages/login",
      "title": "Sign in"
    },
    "main": {
      "widget": "pages/dashboard",
      "layout": "layouts/main-layout",
      "title": "Dashboard"
    },
    "dashboard": {
      "widget": "pages/dashboard",
      "layout": "layouts/main-layout",
      "title": "Dashboard"
    },
    "settings": {
      "widget": "pages/settings",
      "layout": "layouts/main-layout",
      "title": "Settings",
      "can": { "action": "*", "subject": "*" }
    },
    "users": {
      "widget": "pages/users",
      "layout": "layouts/main-layout",
      "title": "Users",
      "can": {
        "any": [
          { "action": "read", "subject": "User" },
          { "action": "write", "subject": "User" },
          { "action": "command", "subject": "users.invite" },
          { "action": "command", "subject": "users.purge" }
        ]
      }
    }
  }
}
