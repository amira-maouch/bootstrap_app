                  }
                }
              ]
            },
            {
              "component": "egret:core:text",
              "id": "mixed-detail",
              "props": {
                "text": "With JavaScript disabled, the avatar and core text remain. The badge is a data-heron-render-mode=client-only component boundary.",
                "className": "small text-muted d-block mb-3"
              }
            },
            {
              "component": "egret:core:section-reference",
              "id": "mixed-client-widget-ref",
