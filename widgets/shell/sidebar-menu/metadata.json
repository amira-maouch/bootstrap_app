{
  "component": "egret:core:widget",
  "id": "sidebar-menu",
  "children": [
    {
      "component": "egret:core:div",
      "id": "sidebar",
      "props": {
        "className": "d-flex flex-column flex-shrink-0 h-100",
        "style": {
          "width": "240px",
          "background": "var(--sidebar)",
          "color": "var(--sidebar-foreground)"
        }
      },
      "children": [
        {
          "component": "egret:core:div",
          "id": "sidebar-brand",
          "props": {
            "className": "d-flex align-items-center gap-2 px-3",
            "style": {
              "height": "48px",
              "borderBottom": "1px solid var(--sidebar-border)"
            }
          },
          "children": [
            {
              "component": "egret:core:text",
              "id": "brand-text",
              "props": {
                "text": "Bootstrap App",
                "className": "fw-semibold fs-6 mb-0",
                "style": { "color": "var(--sidebar-foreground)" }
              }
            }
          ]
        },
        {
          "component": "egret:core:div",
          "id": "nav-section",
          "props": { "className": "flex-grow-1 overflow-auto py-2" },
          "children": [
            {
              "component": "egret:core:div",
              "id": "nav-group-main",
              "props": { "className": "px-2" },
              "children": [
                {
                  "component": "egret:core:text",
                  "id": "nav-group-label",
                  "props": {
                    "text": "NAVIGATION",
                    "className": "px-3 py-1 small fw-medium d-block",
                    "style": { "color": "var(--sidebar-foreground)", "opacity": "0.5" }
                  }
                },
                {
                  "component": "egret:core:link",
                  "id": "nav-dashboard",
                  "alias": "@navDashboard",
                  "props": {
                    "href": "/dashboard",
                    "className": "d-flex align-items-center gap-2 rounded px-3 py-2 mb-1 text-decoration-none",
                    "style": { "color": "var(--sidebar-foreground)", "opacity": "0.75" }
                  },
                  "children": [
                    {
                      "component": "egret:core:text",
                      "id": "nav-dashboard-text",
                      "props": { "text": "Dashboard" }
                    }
                  ]
                },
                {
                  "component": "egret:core:link",
                  "id": "nav-users",
                  "alias": "@navUsers",
                  "can": {
                    "any": [
                      { "action": "read", "subject": "User" },
                      { "action": "write", "subject": "User" },
                      { "action": "command", "subject": "users.invite" },
                      { "action": "command", "subject": "users.purge" }
                    ]
                  },
                  "props": {
                    "href": "/users",
                    "className": "d-flex align-items-center gap-2 rounded px-3 py-2 mb-1 text-decoration-none",
                    "style": { "color": "var(--sidebar-foreground)", "opacity": "0.75" }
                  },
                  "children": [
                    {
                      "component": "egret:core:text",
                      "id": "nav-users-text",
                      "props": { "text": "Users" }
                    }
                  ]
                },
                {
                  "component": "egret:core:link",
                  "id": "nav-settings",
                  "alias": "@navSettings",
                  "can": { "action": "*", "subject": "*" },
                  "props": {
                    "href": "/settings",
                    "className": "d-flex align-items-center gap-2 rounded px-3 py-2 mb-1 text-decoration-none",
                    "style": { "color": "var(--sidebar-foreground)", "opacity": "0.75" }
                  },
                  "children": [
                    {
                      "component": "egret:core:text",
                      "id": "nav-settings-text",
                      "props": { "text": "Settings" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "egret:core:div",
          "id": "sidebar-footer",
          "props": {
            "className": "px-3 py-2 d-flex align-items-center gap-2",
            "style": { "borderTop": "1px solid var(--sidebar-border)" }
          },
          "children": [
            {
              "component": "egret:core:div",
              "id": "user-avatar",
              "props": {
                "className": "rounded-circle d-flex align-items-center justify-content-center fw-bold small flex-shrink-0",
                "style": {
                  "width": "32px",
                  "height": "32px",
                  "background": "var(--sidebar-primary)",
                  "color": "var(--sidebar-primary-foreground)"
                }
              },
              "children": [
                {
                  "component": "egret:core:text",
                  "id": "user-initials",
                  "alias": "@userInitials",
                  "props": { "text": "…" }
                }
              ]
            },
            {
              "component": "egret:core:div",
              "id": "user-info",
              "props": { "className": "overflow-hidden" },
              "children": [
                {
                  "component": "egret:core:text",
                  "id": "user-name",
                  "alias": "@userName",
                  "props": {
                    "text": "Signing in…",
                    "className": "fw-medium small d-block text-truncate",
                    "style": { "color": "var(--sidebar-foreground)" }
                  }
                },
                {
                  "component": "egret:core:text",
                  "id": "user-email",
                  "alias": "@userEmail",
                  "props": {
                    "text": "",
                    "className": "small d-block text-truncate",
                    "style": { "color": "var(--sidebar-foreground)", "opacity": "0.6" }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
