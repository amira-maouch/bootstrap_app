{
  "name": "bootstrap-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && egret-build-app",
    "build:shell": "vite build",
    "build:app": "egret-build-app",
    "build:app:steps": "egret-build-plugins && egret-build-components && egret-build-middleware && egret-build-widgets",
    "clean:artifacts": "egret-clean-artifacts",
    "clean:artifacts:dry": "egret-clean-artifacts --dry-run",
    "dev:server": "egret-dev-api",
    "dev:watch": "egret-watch-widgets --no-initial-build",
    "dev:fake-api": "npm --prefix fake-api start",
    "dev": "pnpm build:app && concurrently -k -n api,server,watch -c magenta,blue,yellow \"pnpm dev:fake-api\" \"pnpm dev:server\" \"pnpm dev:watch\"",
    "start": "egret-prod-server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heron-ws/app-runtime": "file:../heron/packages/app-runtime",
    "@heron-ws/component-api": "file:../heron/packages/component-api",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.4.0",
    "lodash-es": "^4.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "overrides": {
      "@heron-ws/app-runtime": "file:../heron/packages/app-runtime",
      "@heron-ws/app-runtime-core": "file:../heron/packages/app-runtime-core",
      "@heron-ws/app-runtime-server": "file:../heron/packages/app-runtime-server",
      "@heron-ws/component-api": "file:../heron/packages/component-api",
      "@heron-ws/component-registry": "file:../heron/packages/component-registry",
      "@heron-ws/i18n": "file:../heron/packages/i18n",
      "@heron-ws/page-engine": "file:../heron/packages/page-engine",
      "@heron-ws/page-engine-components": "file:../heron/packages/page-engine-components",
      "@heron-ws/utils": "file:../heron/packages/utils"
    }
  }
}
